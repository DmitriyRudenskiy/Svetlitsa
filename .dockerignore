# Контекст сборки ворот. Образ ворот ничего не копирует из репозитория (код
# монтируется в /src), поэтому в контекст не должно попадать ничего тяжёлого:
# без этого файла `docker build` отправляет на демона 336 МиБ референсов из
# idea/ и артефакты из target/.
target/
artifacts/
vendor/
idea/
.git/
.scratch/
.pi/
.DS_Store
**/*.bak-*
